--1.
CREATE TABLE products_big(index integer, "name" text, description text, brand varchar(100), category varchar(75), price numeric(10,2), currency varchar(5), stock integer, EAN text, color varchar(50), size varchar(25), availability text, internal_id integer);


--3.
SELECT COUNT(*) FROM products_big;
SELECT * FROM products_big LIMIT 5;

--4.
EXPLAIN ANALYZE 
SELECT * FROM products_big 
WHERE category = 'Skincare';
--Seq Scan 
--rows removed by filter: 96981 
--planning time: 0.149 ms
--execution time: 49.457 ms

--5.
CREATE INDEX
category_idx
ON products_big(category);

EXPLAIN ANALYZE 
SELECT * FROM products_big 
WHERE category = 'Skincare';

--It switched to a Bitmap Index Scan. 
--The planning time too longer: 5.558 ms. 
--But the execution time was faster: 11.879 ms

--6.
CREATE INDEX idx_big_cat_price
ON products_big(category, price);

EXPLAIN ANALYZE 
SELECT * FROM products_big 
WHERE category = 'Skincare'
AND price >100;
--Bitmap Index Scan, planning time: 5.571 ms, execution time: 4.945 ms


