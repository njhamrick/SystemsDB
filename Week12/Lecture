--Review
--Why primary and foreign keys matter
--In a relational database, data lives in multiple tables, but those tables must be connected somehow
--We do this using keys

--Primary Key(PK): a column or set of columns taht uniquely identify a row in a table
--> student_id, customer_id, product_id

--Foreign Key(FK): a column in one table that refers  to a k in another table
--An fk is just a pk in another table

--Think of PK/FK like a parent-child relationship - a parent can have many childen,
--but each child points to one parent 

--Creating the parent table (customers)
-- create table customers(
-- customer_id serial PRIMARY KEY,
-- name text,
-- email text,
-- city text);

--Serial automatically numbers each new record
--PK ensures each id is unique and not null

--Creating the child table (Orders)
-- create table orders(
-- id serial PRIMARY KEY,
-- customer_id int,
-- product text,
-- total numeric(10,2),
-- FOREIGN KEY(customer_id) REFERENCES customers(customer_id)
-- )


--customer_id linked each order back to a customer
-- the FK constraint prevents orphan records
--You cant create an order for a non-existent customer

